# Copy to .env and fill in. .env is git-ignored.

# Claude writes the content plans and scripts. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs records the voice-over. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
