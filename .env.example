# The easiest way to add keys is the studio's Settings page (the gear at the
# top right): paste, test, save, and it works right away. Keys saved there
# take priority over this file.
#
# Prefer a file? Copy this to .env and fill it in, then restart the studio.
# .env is git-ignored.

# An AI model writes the content plans, scripts, and posts. Claude is the
# default: just set ANTHROPIC_API_KEY. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Or use another provider. LLM_PROVIDER is one of: anthropic, openai, gemini,
# openrouter, groq, deepseek, mistral, xai, together, ollama, lmstudio, custom.
# Each reads its usual key (OPENAI_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY,
# ...), or LLM_API_KEY. Every provider except Claude needs LLM_MODEL.
# LLM_PROVIDER=openai
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=          # required for custom; overrides the preset otherwise
# LLM_JSON_MODE=object   # if the provider rejects JSON Schema output

# ElevenLabs records the voice-over. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: images for image scenes.
# Stock photos come from Openverse (openly licensed, no key needed), or from
# Pexels when this is set. https://www.pexels.com/api/
PEXELS_API_KEY=
# AI illustrations from OpenAI's image model. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5  # same as LLM_MODEL when using Claude
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# OPENAI_IMAGE_MODEL=gpt-image-1

# Running on a server (see "Running on a server" in the README)
# STUDIO_PASSWORD=          # required in production: everyone signs in with it
# STUDIO_SESSION_SECRET=    # optional: signs sessions instead of the password
# STUDIO_KEYS_FROM_ENV=1    # keys only from here; Settings becomes read-only
# STUDIO_SECURE_COOKIE=1    # force Secure cookies if your proxy doesn't send X-Forwarded-Proto
