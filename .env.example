# Copy to .env and fill in. .env is git-ignored.

# Claude writes the content plans and scripts. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs records the voice-over. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: images for image scenes.
# Stock photos come from Openverse (openly licensed, no key needed), or from
# Pexels when this is set. https://www.pexels.com/api/
PEXELS_API_KEY=
# AI illustrations from OpenAI's image model. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# OPENAI_IMAGE_MODEL=gpt-image-1
