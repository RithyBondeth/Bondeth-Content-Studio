{
  "name": "bondeth-content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Turn an idea into a content plan, scripts, voice-over, and animated explainer videos. Built on Claude, ElevenLabs, and Remotion.",
  "license": "MIT",
  "author": "Rithy Bondeth",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render",
    "still": "remotion still",
    "typecheck": "tsc",
    "lint": "eslint src pipeline app studio",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint",
    "pipeline": "tsx pipeline/cli.ts",
    "test": "node --import tsx --test \"pipeline/**/*.test.ts\" \"src/**/*.test.ts\"",
    "studio": "next dev --port 3100",
    "sfx": "tsx pipeline/sfx.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/player": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.536",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
